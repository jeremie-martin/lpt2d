[Unit]
Description=lpt2d publish watcher (server-side; uploads bundles to YouTube)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Prepend ~/lpt2d-publish/bin so a pinned static ffmpeg (>=5.0, required for
# -display_rotation lossless rotate) takes precedence over a too-old apt build.
Environment=PATH=%h/lpt2d-publish/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=%h/lpt2d
ExecStart=%h/lpt2d-publish/venv/bin/python -m publish watch \
    --inbox %h/lpt2d-publish/inbox \
    --music-dir %h/lpt2d-publish/music \
    --credentials-dir %h/lpt2d-publish/credentials \
    --state-file %h/lpt2d-publish/state.json \
    --ledger-dir %h/lpt2d-publish \
    --log-file %h/lpt2d-publish/watcher.log \
    --privacy public \
    --playlist PL2G6-wO4Mi9-_XhA9GiD6Pd8N3K2X0NQO \
    --min-interval 3600 \
    --interval 60
Restart=always
RestartSec=30s

[Install]
WantedBy=default.target
