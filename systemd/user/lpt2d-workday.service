[Unit]
Description=lpt2d workday continuous render+ship (Mon-Fri 09:30–17:30)
Conflicts=lpt2d-nightly.service lpt2d-manual.service

[Service]
Type=simple
WorkingDirectory=%h/prog/lpt2d
Environment=LPT2D_WINDOW=workday
ExecStart=%h/prog/lpt2d/scripts/lpt2d-render-and-ship.sh
RuntimeMaxSec=8h
TimeoutStopSec=120
KillSignal=SIGTERM
SuccessExitStatus=SIGTERM
Restart=no

[Install]
WantedBy=default.target
